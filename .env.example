# EdgeQuant
DATABASE_URL=postgresql://user:pass@localhost:5432/edgequant
SETTINGS_PIN=123456                 # unlocks the Settings page
SETTINGS_ENCRYPTION_KEY=            # 64 hex chars; encrypts keys saved in Settings
CRON_SECRET=                        # protects the scheduled-job URLs

# Data sources
# Crypto needs no key (Binance or Bybit public endpoints).
TWELVE_DATA_KEY=                    # free key for FX (800 requests/day) — twelvedata.com
SOURCE_DELAY_MS=400                 # spacing between requests

# Behaviour
PREDICTION_MIN_EDGE_R=0.02          # ignore signals whose expected R after costs is below this

# --- Token screener (Solana) ---
# Authorities and holder distribution are read straight off the mint account, so an RPC is required for
# the checks that matter most. Without it those checks report "unknown", never "pass".
SOLANA_RPC_URL=
# Size of the sell simulation in USD. Small enough to be realistic, big enough to be honest.
SELL_PROBE_USD=50
