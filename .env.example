# EdgeQuant
DATABASE_URL=postgresql://edgequant:edgequant@localhost:5432/edgequant   # matches docker-compose.yml
SETTINGS_PIN=123456                 # unlocks the Settings page
SETTINGS_ENCRYPTION_KEY=            # 64 hex chars; encrypts keys saved in Settings
CRON_SECRET=                        # protects the scheduled-job URLs

# Data sources
# Crypto needs no key (Binance or Bybit public endpoints). The default Binance host is
# data-api.binance.vision, its market-data-only endpoint, because api.binance.com replies HTTP 451 from
# many cloud IPs and Bybit replies 403 to the same addresses. Override either if yours can reach them.
BINANCE_BASE_URL=
BYBIT_BASE_URL=
TWELVE_DATA_KEY=                    # free key for FX (800 requests/day) — twelvedata.com
SOURCE_DELAY_MS=400                 # spacing between requests
TWELVE_DATA_SPACING_MS=8000         # free plan allows 8 requests/minute; raise this, not SOURCE_DELAY_MS

# Behaviour
PREDICTION_MIN_EDGE_R=0.02          # ignore signals whose expected R after costs is below this

# --- Token screener (Solana) ---
# Authorities and holder distribution are read straight off the mint account, so an RPC is required for
# the checks that matter most. Without it those checks report "unknown", never "pass".
SOLANA_RPC_URL=
# Size of the sell simulation in USD. Small enough to be realistic, big enough to be honest.
SELL_PROBE_USD=50
# Three checks need indexed history rather than a single account read: whether the pool's LP was burned
# or locked, what the deployer launched before, and who took the supply in the opening slots. A Helius
# RPC URL above covers all three (the key is read from it); set this only if you use a different RPC.
HELIUS_API_KEY=
